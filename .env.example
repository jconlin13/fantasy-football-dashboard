# Only needed if the league is private. Copy to .env and fill in.
#
# To get these: sign in to fantasy.espn.com in Chrome, open DevTools ->
# Application -> Cookies -> https://fantasy.espn.com, and copy the two values.
#
# .env is gitignored. For the scheduled refresh these same two values go in
# GitHub repo Settings -> Secrets and variables -> Actions.

SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=
